# PROXY SETTINGS
SF_CMS_URL=http://localhost

# Sitefinity Cloud settings
# SF_LOCAL_VALIDATION_KEY=

# NEXT SETTINGS
# NEXT_PUBLIC_SF_CMS_URL=https://localhost:5001/

# Use this variable when making requests to a CMS, where a dev SSL is configured. This bypasses the SSL validation for NEXT server side rendering
NODE_TLS_REJECT_UNAUTHORIZED="0"

# Specify a different web service path that the renderer should use. It is recommended to have its access set to Anonymous.
# The default for Sitefinity is: api/default
# The default for Sitefinity Next Gen is: sf/api/v1/default
# SF_WEBSERVICE_PATH=""

# Specify a different web service path that the renderer should use for communication with the search service.
# NEXT_PUBLIC_SF_SEARCH_WEBSERVICE_PATH=""

# Use this variable to set whitelisted urls of NextJs pages or paths. Only these paths will be handled by the Renderer. The values should be comma separated.
# SF_WHITELISTED_NEXTJS_PATHS="p2,p3"

# Configure the request cache type
#SF_SDK_CACHE=""

# Set the cache lifetime of a resource (in seconds)
#SF_SDK_CACHE_REVALIDATE=""

# Indicates whether the server is SF NEXT gen or not
# NEXT_PUBLIC_SF_NEXT_GEN=1

NEXT_TELEMETRY_DISABLED=1
